{deps_dir, "deps"}.


{src_dirs, [
    "src",
    "src/app",
    "src/admin",
    "src/cryptography",
    "src/dynamic",
    "src/events",
    "src/handshake",
    "src/ovpn",
    "src/peers",
    "src/projection",
    "src/provisioning",
    "src/session",
    "src/storage",
    "src/transport"
]}.

{erl_opts, [debug_info, warn_unused_vars, warn_shadow_vars, warn_unused_import]}.

{deps, [
    {tunctl, "1.0.0"},
    {cowboy, "2.12.0"},
    {kvs, ".*", {git, "https://github.com/zencrypted/kvs", []}}
]}.

{overrides, [
    {override, kvs, [
        {deps, []},
        {pre_hooks, [
            {compile,
                "perl -0pi -e 's/,rocksdb//g' src/kvs.app.src"}
        ]}
    ]}
]}.

{relx, [
    {release, {vpn, "0.1.0"}, [vpn]},
    {dev_mode, true},
    {include_erts, false},
    {sys_config, "config/sys.config"},
    {vm_args, "config/vm.args"}
]}.

{shell, [
    {config, "config/sys.config"}
]}.

{profiles, [
    {test, [
        {erl_opts, [debug_info]},
        {extra_src_dirs, [
            "test/app",
            "test/cryptography",
            "test/dynamic",
            "test/events",
            "test/handshake",
            "test/ovpn",
            "test/peers",
            "test/projection",
            "test/provisioning",
            "test/session",
            "test/storage",
            "test/support"
        ]}
    ]},
    {debug, [
        {shell, [{config, "config/sys.debug.config"}]}
    ]}
]}.
